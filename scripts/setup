#!/bin/sh
set -eu

# Locate this script without tools from the inherited PATH.
case $0 in
    */*) script_dir=${0%/*} ;;
    *) script_dir=. ;;
esac
script_dir=$(CDPATH= cd -- "$script_dir" && pwd -P)
project_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
unset PGVIDEO_ENV_READY PGVIDEO_LOCAL_ENV PGVIDEO_SANDBOX
# Keep the dynamic loader from adding inherited libraries to the project's Python.
unset LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
cd "$project_root"

if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != --offline ]; }; then
    echo 'setup: usage: scripts/setup [--offline]' >&2
    exit 2
fi

for path in .runtime .runtime/python .runtime/python/bin .runtime/python/bin/python3.11 \
    .venv .venv/bin .venv/bin/python cache cache/downloads cache/wheels; do
    if [ -L "$path" ]; then
        echo "setup: $path must not be a symlink" >&2
        exit 1
    fi
done
for path in .runtime .runtime/python .runtime/python/bin .venv .venv/bin cache cache/downloads cache/wheels; do
    if [ -e "$path" ] && [ ! -d "$path" ]; then
        echo "setup: $path must be a directory" >&2
        exit 1
    fi
done
/bin/mkdir -p .runtime/python .runtime/home .runtime/tmp cache/downloads cache/wheels

runtime_archive=cache/downloads/cpython-3.11.16-20260924-x86_64-unknown-linux-gnu.tar.gz
runtime_url='https://github.com/astral-sh/python-build-standalone/releases/download/20260924/cpython-3.11.16%2B20260924-x86_64-unknown-linux-gnu-install_only.tar.gz'
runtime_sha='49a52eb189878431a36efd137e7cd08f6429e59dc049b9cfb030bf706eb33fd4'

if [ "$(/usr/bin/uname -s)" != Linux ] || [ "$(/usr/bin/uname -m)" != x86_64 ]; then
    echo 'setup: this lock supports Linux x86_64 only' >&2
    exit 1
fi
if [ ! -f "$runtime_archive" ]; then
    if [ "${1:-}" = --offline ]; then
        echo "setup: offline setup needs $runtime_archive" >&2
        exit 1
    fi
    HOME="$project_root/.runtime/home" TMPDIR="$project_root/.runtime/tmp" \
        /usr/bin/curl -q -fL --retry 3 "$runtime_url" -o "$runtime_archive"
fi
if ! printf '%s  %s\n' "$runtime_sha" "$runtime_archive" | /usr/bin/sha256sum -c -; then
    echo 'setup: local Python archive checksum differs from tools.lock' >&2
    exit 1
fi
if [ ! -x .runtime/python/bin/python3.11 ]; then
    /usr/bin/env -i PATH=/usr/bin:/bin /usr/bin/tar -xzf "$runtime_archive" -C .runtime/python --strip-components=1
fi
if [ ! -x .venv/bin/python ]; then
    HOME="$project_root/.runtime/home" TMPDIR="$project_root/.runtime/tmp" \
        .runtime/python/bin/python3.11 -I -m venv --copies .venv
fi
# Install inside the networked sandbox, then prove the result works offline.
.venv/bin/python -I scripts/environment.py setup "$@"
exec .venv/bin/python -I scripts/environment.py doctor --sample
