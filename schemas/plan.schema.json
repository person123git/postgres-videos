{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgvideo.invalid/schemas/plan.schema.json",
  "title": "pgvideo content plan, version 2",
  "description": "The working plan for one video: the request it serves, the main answer, the claims to teach in order, the caveats that must survive, a time budget per outline item, and a reason for every section left out. It is the author's own record. No pgvideo command reads it; a later session resumes from it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "document", "audience", "detail", "target_minutes", "main_answer", "learning_objectives",
               "claims", "outline", "omissions", "feasibility"],
  "properties": {
    "schema": {"const": "pgvideo/plan/v2"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "description": "The wiki page the video explains, by its path in the wiki repository, such as wiki/v18/page.md"},
        "version": {"type": ["integer", "string"], "description": "The PostgreSQL version the page describes"}
      }
    },
    "audience": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Who the video is for, as the user asked"},
    "detail": {"enum": ["summary", "standard", "full"], "description": "The level of detail the user asked for"},
    "target_minutes": {"type": ["number", "null"], "exclusiveMinimum": 0, "description": "The duration the user asked for; null for full detail"},
    "main_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claims"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 600},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "learning_objectives": {"type": "array", "minItems": 1, "maxItems": 8,
                            "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "claims": {"type": "array", "minItems": 1, "maxItems": 3000, "items": {"$ref": "#/$defs/claim"}},
    "outline": {"type": "array", "minItems": 1, "maxItems": 600, "items": {"$ref": "#/$defs/outline_item"}},
    "required_caveats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "reason"],
        "properties": {
          "claim": {"$ref": "#/$defs/id"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 400}
        }
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "reason"],
        "properties": {
          "section": {"type": "string", "minLength": 1, "description": "The heading of a section of the page"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 400}
        }
      }
    },
    "feasibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["feasible", "infeasible"]},
        "note": {"type": "string", "maxLength": 1000, "description": "For an infeasible plan: which mandatory content does not fit the target"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
           "description": "An ID you choose: lowercase letters, digits, and hyphens"},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "kind", "sources"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "minLength": 1, "maxLength": 800},
        "kind": {"enum": ["answer", "fact", "mechanism", "condition", "caveat", "example", "definition", "context"]},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1},
                    "description": "Where the page states the claim: section headings or line ranges"},
        "glossary": {"type": "array", "items": {"type": "string", "minLength": 1},
                     "description": "The glossary terms the claim uses"},
        "depends_on": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "assessment": {"$ref": "#/$defs/assessment"}
      }
    },
    "assessment": {
      "type": "object",
      "description": "Your own check of the claim against what its sources cite",
      "additionalProperties": false,
      "required": ["source_support", "justification"],
      "properties": {
        "source_support": {"enum": ["supported", "contradicted", "insufficient_evidence"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1},
                     "description": "What you read: the page's citations, such as src/backend/utils/misc/guc_tables.c#L120-L160"},
        "justification": {"type": "string", "minLength": 1, "maxLength": 600},
        "glossary": {"enum": ["consistent", "inconsistent", "not_applicable"]}
      }
    },
    "outline_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "part", "title", "purpose", "claims", "budget_seconds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "part": {"enum": ["opening", "question", "terminology", "answer", "mechanism", "example", "caveat",
                          "supporting", "open_questions", "recap", "credits"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 400},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "budget_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600}
      }
    }
  }
}
