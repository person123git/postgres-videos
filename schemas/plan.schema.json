{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgvideo.invalid/schemas/plan.schema.json",
  "title": "pgvideo content plan, version 1",
  "description": "The harness-authored content plan for one request. It selects and orders claims from the evidence packet, assesses each claim against its evidence, budgets narration time, and gives a reason for every omitted section. pgvideo resolves every ID, recomputes the duration estimate, and assigns the plan's status; statuses are never accepted from this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "evidence_digest", "producer", "audience", "detail", "target_minutes",
               "main_answer", "learning_objectives", "claims", "outline", "omissions", "feasibility"],
  "properties": {
    "schema": {"const": "pgvideo/plan/v1"},
    "request_id": {"type": "string", "minLength": 1},
    "evidence_digest": {"$ref": "#/$defs/digest", "description": "digests.content of evidence-packet.json, as `status` reports it"},
    "producer": {"$ref": "#/$defs/producer"},
    "audience": {"type": "string", "minLength": 1, "maxLength": 200, "description": "The request's audience, unchanged"},
    "detail": {"enum": ["summary", "standard", "full"], "description": "The request's level of detail, unchanged"},
    "target_minutes": {"type": ["number", "null"], "exclusiveMinimum": 0, "description": "The request's target, unchanged; null for full detail"},
    "main_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claims"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 600},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "learning_objectives": {"type": "array", "minItems": 1, "maxItems": 8,
                            "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "claims": {"type": "array", "minItems": 1, "maxItems": 3000, "items": {"$ref": "#/$defs/claim"}},
    "outline": {"type": "array", "minItems": 1, "maxItems": 600, "items": {"$ref": "#/$defs/outline_item"}},
    "required_caveats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "reason"],
        "properties": {
          "claim": {"$ref": "#/$defs/id"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 400}
        }
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "reason"],
        "properties": {
          "section": {"type": "string", "minLength": 1, "description": "A section ID from the evidence packet"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 400}
        }
      }
    },
    "feasibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["feasible", "infeasible"]},
        "note": {"type": "string", "maxLength": 1000, "description": "For an infeasible plan: which mandatory content does not fit the target"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
           "description": "An ID you choose: lowercase letters, digits, and hyphens. Document unit IDs such as short-answer.1.s1 keep their dots wherever they are cited; do not rename them to fit this pattern"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {"type": "string", "minLength": 1, "maxLength": 400,
                  "description": "A document unit ID (section, block, sentence, or table row), pg:<path>#L<a>-L<b>, guc:<setting>, or glossary:<anchor>"},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "kind", "sources", "assessment"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "minLength": 1, "maxLength": 800},
        "kind": {"enum": ["answer", "fact", "mechanism", "condition", "caveat", "example", "definition", "context"]},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1},
                    "description": "Document sentence, row, block, or section IDs that state the claim"},
        "glossary": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "depends_on": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "assessment": {"$ref": "#/$defs/assessment"}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_support", "evidence", "justification", "glossary"],
      "properties": {
        "source_support": {"enum": ["supported", "contradicted", "insufficient_evidence"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "justification": {"type": "string", "minLength": 1, "maxLength": 600},
        "glossary": {"enum": ["consistent", "inconsistent", "not_applicable"]}
      }
    },
    "outline_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "part", "title", "purpose", "claims", "budget_seconds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "part": {"enum": ["opening", "question", "terminology", "answer", "mechanism", "example", "caveat",
                          "supporting", "open_questions", "recap", "credits"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 400},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "budget_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness"],
      "properties": {
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string"}}
        },
        "model": {"oneOf": [
          {"const": "unavailable"},
          {"type": "object", "additionalProperties": false,
           "properties": {"requested": {"type": "string"}, "resolved": {"type": "string"}, "provider": {"type": "string"}}}
        ]},
        "prompt": {"enum": ["prompts/plan.md", "prompts/draft.md", "prompts/review.md", "prompts/repair.md"]},
        "parameters": {"oneOf": [{"const": "unavailable"}, {"type": "object"}]},
        "usage": {"oneOf": [{"const": "unavailable"}, {"type": "object", "additionalProperties": {"type": "number"}}]},
        "latency_seconds": {"oneOf": [{"const": "unavailable"}, {"type": "number", "minimum": 0}]},
        "replayed_from": {"type": "string"}
      }
    }
  }
}
