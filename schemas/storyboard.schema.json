{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgvideo.invalid/schemas/storyboard.schema.json",
  "title": "pgvideo harness storyboard, version 2",
  "description": "The scene file a harness writes from the accepted content plan. Every factual narration item names the plan claims it states and the evidence that supports it. Derived fields such as statuses, checks, word counts, and TTS text from the pronunciation dictionary are computed by pgvideo and must not appear here. Version 1 scene files remain valid only for requests made before the harness workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "plan_digest", "producer", "scenes"],
  "properties": {
    "schema": {"const": "pgvideo/storyboard/v2"},
    "request_id": {"type": "string", "minLength": 1},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "digests.plan_digest from `status`"},
    "producer": {"$ref": "plan.schema.json#/$defs/producer"},
    "scenes": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"$ref": "#/$defs/scene"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "part", "title", "screen", "narration"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "part": {"enum": ["opening", "question", "terminology", "answer", "mechanism", "example", "caveat",
                          "supporting", "open_questions", "recap", "credits"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "screen": {"$ref": "#/$defs/screen"},
        "visual": {"type": "string", "maxLength": 400, "description": "What the screen teaches, in one or two sentences"},
        "narration": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/narration"}},
        "sources": {"$ref": "#/$defs/strings"},
        "glossary": {"$ref": "#/$defs/strings"},
        "citations": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "origin"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 1200, "description": "Display text: captions and transcript"},
        "origin": {"enum": ["document", "table", "correction", "glossary", "paraphrase", "framing"],
                   "description": "framing carries no technical claim; every other origin needs claims and sources"},
        "sources": {"$ref": "#/$defs/strings"},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "evidence": {"type": "array", "items": {"$ref": "plan.schema.json#/$defs/reference"}},
        "glossary": {"$ref": "#/$defs/strings"},
        "citations": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "correction": {"type": "string"},
        "tts": {"type": "string", "minLength": 1, "maxLength": 1200},
        "tts_source": {"enum": ["dictionary", "manual"]}
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout"],
      "properties": {
        "layout": {"enum": ["title", "question", "bullets", "steps", "code", "table", "diagram", "terms", "image", "credits"]},
        "heading": {"type": "string", "maxLength": 200},
        "lines": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 300}},
        "code": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "content"],
          "properties": {
            "source": {"type": "string"}, "first_line": {"type": "integer", "minimum": 1},
            "content": {"type": "string"}, "language": {"type": ["string", "null"]}, "kind": {"type": ["string", "null"]}
          }
        },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "header", "rows"],
          "properties": {
            "source": {"type": "string"},
            "header": {"type": "array", "items": {"type": "string"}},
            "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
          }
        },
        "diagram": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "edges"],
          "properties": {
            "nodes": {"type": "array", "minItems": 2, "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "label"],
              "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}}},
            "edges": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false, "required": ["from", "to", "label", "source", "claims"],
              "properties": {
                "from": {"type": "string"}, "to": {"type": "string"}, "label": {"type": "string", "minLength": 1},
                "source": {"type": "string", "minLength": 1, "description": "The narrated sentence ID that states this relationship"},
                "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"},
                           "description": "The plan claims that justify the edge's direction and label"}}}}
          }
        },
        "terms": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["anchor", "term", "definition"],
          "properties": {"anchor": {"type": "string"}, "term": {"type": "string"}, "definition": {"type": "string"}}}},
        "image": {"type": "object", "additionalProperties": false, "required": ["link"],
                  "properties": {"link": {"type": "integer", "minimum": 0}}},
        "footer": {"type": "string", "maxLength": 200}
      }
    }
  }
}
